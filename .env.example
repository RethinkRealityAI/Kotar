# Copy to .env for local `netlify dev`, and add the same keys in
# Netlify > Site configuration > Environment variables for production.

# --- AI (Gemini) ---------------------------------------------------------
# Create a key at https://aistudio.google.com/app/apikey and paste it here.
# The key is only ever read inside the ai-draft function; it never reaches the browser.
GEMINI_API_KEY=

# Optional: which Gemini model to use for drafting (leave blank to auto-pick the newest stable Gemini flash model).
GEMINI_MODEL=

# --- Access --------------------------------------------------------------
# A passcode everyone at Kotar types once to open the app. Leave empty to
# disable the gate while developing (do NOT leave it empty in production).
APP_PASSCODE=

# Optional: the public URL used in client links and emails (defaults to the request origin).
PUBLIC_URL=
